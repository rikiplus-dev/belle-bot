{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bellebot",
  "main": "src/index.js",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/telegram"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bellebot",
      "database_id": "REPLACE_WITH_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "vars": {
    "TZ": "Asia/Jerusalem"
  },
  "observability": {
    "enabled": true
  }
}
